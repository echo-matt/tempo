    <!--
      Tempo palette. Neutral greys carry the chrome so cover art carries the colour,
      and the accent is Tempo's own logo coral rather than the Material 3 baseline purple.

      The light accent is a darkened coral: #f24b6a only reaches 3.5:1 on white, which
      fails WCAG AA for text and icons. On the dark background the full coral is 5.9:1
      against the on-primary ink, so it is used as-is there.
    -->

    <color name="md_theme_light_primary">#C22F4C</color>
    <color name="md_theme_light_onPrimary">#FFFFFF</color>
    <color name="md_theme_light_primaryContainer">#FFD9E0</color>
